+FString FPLATEAUTextureLoader::GetTexturePackageName(const FString& TexturePath) {
+    FString CanonicalPath = TexturePath;
+    FPaths::NormalizeFilename(CanonicalPath);
+    CanonicalPath = FPaths::ConvertRelativePathToFull(CanonicalPath);
+    FPaths::CollapseRelativeDirectories(CanonicalPath);
+
+    // Imported GML appearance files live below Content/PLATEAU. Keeping their
+    // relative path makes asset identity independent of the project location.
+    FString SourceRoot = FPaths::ConvertRelativePathToFull(FPaths::ProjectContentDir());
+    FPaths::NormalizeDirectoryName(SourceRoot);
+    SourceRoot += TEXT("/PLATEAU/");
+    FPaths::MakePathRelativeTo(CanonicalPath, *SourceRoot);
+
+    const FTCHARToUTF8 PathBytes(*CanonicalPath);
+    const FString Digest = FMD5::HashBytes(
+        reinterpret_cast<const uint8*>(PathBytes.Get()), PathBytes.Length());
+    return TEXT("/Game/PLATEAU/Textures/T_") + Digest;
+}
