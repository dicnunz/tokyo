diff --git aSource/PLATEAUTests/Tests/Utils/PLATEAUTextureIdentityTest.cpp bSource/PLATEAUTests/Tests/Utils/PLATEAUTextureIdentityTest.cpp
new file mode 100644
index 0000000..fa04b58
--- /dev/null
+++ bSource/PLATEAUTests/Tests/Utils/PLATEAUTextureIdentityTest.cpp
@@ -0,0 +1,29 @@
+#include "Misc/AutomationTest.h"
+#include "Misc/Paths.h"
+#include "PLATEAUTextureLoader.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FPLATEAUTextureIdentityTest,
+    "PLATEAUTest.Tokyo.TextureSourceIdentity",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FPLATEAUTextureIdentityTest::RunTest(const FString& Parameters) {
+    const FString Root = FPaths::ProjectContentDir() + TEXT("PLATEAU/fixture/udx/bldg/");
+    const FString First = Root + TEXT("53393585_bldg_6697_appearance/Texture_WallSurface_jpg24.jpg");
+    const FString Second = Root + TEXT("53393586_bldg_6697_appearance/Texture_WallSurface_jpg24.jpg");
+    const FString FirstPackage = FPLATEAUTextureLoader::GetTexturePackageName(First);
+    TestNotEqual(TEXT("Different source facades with the same basename stay separate"),
+        FirstPackage, FPLATEAUTextureLoader::GetTexturePackageName(Second));
+    TestEqual(TEXT("Equivalent source paths reuse the texture asset"), FirstPackage,
+        FPLATEAUTextureLoader::GetTexturePackageName(
+            Root + TEXT("53393585_bldg_6697_appearance/./Texture_WallSurface_jpg24.jpg")));
+    TestEqual(TEXT("Slash direction does not change source identity"), FirstPackage,
+        FPLATEAUTextureLoader::GetTexturePackageName(First.Replace(TEXT("/"), TEXT("\\"))));
+    TestNotEqual(TEXT("Unicode appearance folders retain their identity"),
+        FPLATEAUTextureLoader::GetTexturePackageName(Root + TEXT("東京/wall.jpg")),
+        FPLATEAUTextureLoader::GetTexturePackageName(Root + TEXT("大阪/wall.jpg")));
+    TestTrue(TEXT("Generated identity stays in the texture package folder"),
+        FirstPackage.StartsWith(TEXT("/Game/PLATEAU/Textures/T_")));
+    return true;
+}
+#endif
